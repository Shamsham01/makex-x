# Render / local environment — backend API only (NOT Make.com)
# Copy to .env for local dev. On Render, set these in the dashboard or via render.yaml sync:false.

# Required — must match Make common.apiKey: "Bearer <this value>"
SECURE_TOKEN=your_long_random_secret

# Public URL of this service (no trailing slash)
CURRENT_URL=https://makex-x.onrender.com
PORT=10000

# Optional — MultiversX usage-fee whitelist (same as other MakeX apps)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# X OAuth client credentials belong in Make.com Common data, NOT here.
# Make runs the OAuth flow; modules pass accessToken to this API.
